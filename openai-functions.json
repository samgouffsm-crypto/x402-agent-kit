  {
    "type": "function",
    "function": {
      "name": "tenderwatch_search",
      "description": "[Government procurement search and fit-scoring] Search procurement opportunities Priced $0.02 USDC per call via x402 on Base.",
      "parameters": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Keyword search (title/full-text)"
          },
          "source": {
            "type": "string",
            "description": "sam | ted | all (default all)",
            "enum": [
              "sam",
              "ted",
              "all"
            ]
          },
          "naics": {
            "type": "string",
            "description": "NAICS code filter (SAM)"
          },
          "psc": {
            "type": "string",
            "description": "PSC filter, e.g. D316 (SAM, client-side)"
          },
          "setAside": {
            "type": "string",
            "description": "Set-aside code filter, e.g. SBA (SAM)"
          },
          "postedFrom": {
            "type": "string",
            "description": "YYYY-MM-DD (default 30 days ago)"
          },
          "postedTo": {
            "type": "string",
            "description": "YYYY-MM-DD (default today)"
          },
          "limit": {
            "type": "integer",
            "description": "1\u2013100 (default 20)"
          }
        },
        "required": []
      }
    },
    "_meta": {
      "service": "tenderwatch",
      "base_url": "https://x402-tenderwatch.onrender.com",
      "method": "GET",
      "path": "/search",
      "price_usdc": "$0.02"
    }
  },
